// Cloudflare Workers config: serves the Vite build in ./dist as static assets.
// Having this file stops `wrangler deploy` from trying to auto-configure the project.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "work-me-out",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
